# ==========================================
# SERVER ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ------------------------------------------
# Server
# ------------------------------------------
PORT=3000

# ------------------------------------------
# MongoDB Atlas Connection String
# ------------------------------------------
# Get this from MongoDB Atlas:
#   Cluster → Connect → Drivers → Node.js
# Replace <username>, <password>, and <database-name> with your values.
# Example:
#   MONGO_URI=mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/campus?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# ------------------------------------------
# JSON Web Token
# ------------------------------------------
# Use a long, random string. At least 64 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ------------------------------------------
# CORS — Frontend origin(s)
# ------------------------------------------
# In development: http://localhost:5173
# In production: https://your-deployed-frontend-domain.com
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------
# Cloudinary (optional — for file uploads)
# ------------------------------------------
# Leave these blank if you are not using Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
